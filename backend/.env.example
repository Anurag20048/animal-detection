# Application
APP_ENV=development
DEBUG=true
HOST=127.0.0.1
PORT=8000

# YOLO / detection
YOLO_MODEL_PATH=yolov8n.pt
YOLO_TRACKER_CONFIG=bytetrack.yaml
CONFIDENCE_THRESHOLD=0.35
RECOGNITION_THRESHOLD=0.80
EMBEDDING_MOMENTUM=0.90
RESNET_PRETRAINED=true

# Camera
CAMERA_SOURCE=0
CAMERA_ID=CAM-001
CAMERA_NAME=Local Camera
CAMERA_LOCATION=Local Development
CAMERA_LATITUDE=
CAMERA_LONGITUDE=

# Database
DATABASE_URL=sqlite:///./data/app.db
MONGODB_URL=
MONGODB_DATABASE=animal_detection

# Authentication
SECRET_KEY=change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
